<Window x:Class="Flow.Launcher.Plugin.Zoxide.Views.CommandEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Flow.Launcher.Plugin.Zoxide.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:CommandEditViewModel}"
        Background="{DynamicResource PopuBGColor}"
        Foreground="{DynamicResource PopupTextColor}"
        mc:Ignorable="d"
        Title="{DynamicResource flowlauncher_plugin_zoxide_dialog_command_title}"
        Height="Auto"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{DynamicResource flowlauncher_plugin_zoxide_dialog_command_title}"
                   TextAlignment="Left" />
        <TextBlock Grid.Row="1"
                   FontWeight="SemiBold"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,12,8"
                   Text="{DynamicResource flowlauncher_plugin_zoxide_lbl_command_name}" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 MinHeight="24"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,12,8"
                   Text="{DynamicResource flowlauncher_plugin_zoxide_lbl_command_executable}" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 MinHeight="24"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,8"
                 Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   FontWeight="SemiBold"
                   VerticalAlignment="Top"
                   Margin="0,6,12,8"
                   Text="{DynamicResource flowlauncher_plugin_zoxide_lbl_command_arguments}" />
        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 MinHeight="72"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,12,8"
                   Text="{DynamicResource flowlauncher_plugin_zoxide_lbl_command_zoxide_add}" />
        <CheckBox Grid.Row="4"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Margin="0,0,0,8"
                  IsChecked="{Binding ZoxideAddOnSuccess, Mode=TwoWay}" />

        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Content="{DynamicResource flowlauncher_plugin_zoxide_btn_dialog_ok}"
                    Command="{Binding OkCommand}" />
            <Button MinWidth="88"
                    IsCancel="True"
                    Content="{DynamicResource flowlauncher_plugin_zoxide_btn_dialog_cancel}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
